# ==============================================================================
# DEVELOPER ARCHITECTURE NOTE:
# MODULE:    Grand Public Production Launch & System Handover
# TOPIC:     Phase 141 SEO, 64-District OpenGraph Engine, Production CI/CD & National Handover
# FILE:      .env.production.example
# PHASE:     Phase 141 - Grand Public Production Launch & Final Handover
# PURPOSE:   Complete documentation of production environment variables, keys, and endpoints
# STANDARDS: Zero-Emoji, Zero-IDOR, Production Grade, WCAG 2.2 AAA, Full 64-District Support
# ==============================================================================

# Core Application Runtime
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
PUBLIC_APP_URL=https://studentlifecircle.com

# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgresql://slc_admin:YOUR_STRONG_PROD_DB_PASSWORD@localhost:5432/studentlifecircle_prod
DB_POOL_MIN=10
DB_POOL_MAX=50

# Supabase Auth, Storage & Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key_here

# Redis In-Memory Cache & Session Broker
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Payment Gateways (Live Production Mode)
PAYMENT_MODE=live

# bKash Merchant Checkout API (v1.2.0-beta)
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_live_bkash_app_key
BKASH_APP_SECRET=your_live_bkash_app_secret
BKASH_USERNAME=your_live_bkash_merchant_username
BKASH_PASSWORD=your_live_bkash_merchant_password

# Nagad Payment Gateway (DFS PG API)
NAGAD_BASE_URL=https://api.mynagad.com/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=your_live_nagad_merchant_id
NAGAD_PRIVATE_KEY=/path/to/rsa_private_key.pem
NAGAD_PUBLIC_KEY=/path/to/nagad_pg_public_key.pem

# SSLCommerz Hosted Session Gateway (Cards & Internet Banking)
SSLC_STORE_ID=your_live_sslcommerz_store_id
SSLC_STORE_PASSWD=your_live_sslcommerz_store_password

# Cryptographic Token & JWT Signing
JWT_SECRET=generate_strong_64_character_random_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Observability, Monitoring & Sentry
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=true
