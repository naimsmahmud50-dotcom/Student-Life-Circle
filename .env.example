# ========================================================================================
# MODULE:    Environment Configuration Template
# TOPIC:     Secret Keys, Database Connection, Redis Cache & Microservice Ports
# FILE:      .env.example
# PURPOSE:   Documents all required environment variables for the Student Growth Platform.
#            Zero secrets are committed to version control. Copy to .env and configure.
# AUDIENCE:  DevOps, Systems Administrators & Full-Stack Developers
# STANDARDS: 12-Factor App, OWASP ASVS L2 Secret Management
# ========================================================================================

# General Platform Settings
ENVIRONMENT=development
PROJECT_NAME="Student Growth Platform (অগ্রযাত্রা)"
API_V1_STR=/api/v1
VERSION=2.0.0

# Security & Authentication (Argon2id + JWT)
# Generate a cryptographically random 64-character secret in production using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_HASH_WORK_FACTOR=12

# PostgreSQL Database (AsyncPG)
POSTGRES_USER=ogrojatra_admin
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=ogrojatra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ogrojatra_admin:replace_with_strong_password@localhost:5432/ogrojatra_db

# Redis In-Memory Cache & Exam Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@localhost:6379/0

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
